# Configuración de Firebase - Tamagotchi App
# IMPORTANTE: Nunca compartir este archivo ni sus valores
# Copia este archivo como .env.local y completa los valores

# Clave API de Firebase (obtener de Firebase Console → Project Settings → Web apps)
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Dominio de autenticación
VITE_FIREBASE_AUTH_DOMAIN=tamagotchi-entrega.firebaseapp.com

# ID del proyecto
VITE_FIREBASE_PROJECT_ID=tamagotchi-entrega

# Bucket de almacenamiento
VITE_FIREBASE_STORAGE_BUCKET=tamagotchi-entrega.firebasestorage.app

# Sender ID de Messaging
VITE_FIREBASE_MESSAGING_SENDER_ID=642802937477

# App ID
VITE_FIREBASE_APP_ID=1:642802937477:web:XXXXXXXXXXXXXXXX

# Measurement ID (opcional)
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# URL del servidor de IA (Flask)
# Desarrollo: http://localhost:5001
# Producción: https://tu-api.onrender.com (cambiar por la URL real de Render)
VITE_AI_API_URL=http://localhost:5001

# NOTAS DE SEGURIDAD:
# 1. Las API keys de Firebase tienen restricciones por dominio
# 2. Configura los orígenes autorizados en Firebase Console
# 3. Nunca expongas este archivo en repositorios públicos
# 4. Añade .env.local al archivo .gitignore
